# Копирај го овој фајл како .env.local и пополни ги вредностите.
# .env.local не се комитира (е во .gitignore).

# Resend API Key - добиј го од https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Е-пошта на која ќе пристигнуваат пораките
CONTACT_EMAIL=zmaga.dooel@yahoo.com

# Sender адреса од домен верификуван во Resend.
# Додека доменот не е верификуван, остави ја линијата коментирана и
# локално ќе се користи onboarding@resend.dev.
# RESEND_FROM_EMAIL=Zmaga Cigli <contact@zmagacigli.com>

# Upstash Redis — shared rate limiting за Vercel/serverless instances
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Vercel Native Upstash со custom prefix UPSTASH_REDIS_REST ги создава овие имиња:
# UPSTASH_REDIS_REST_KV_REST_API_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN=your_upstash_rest_token
