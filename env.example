# Копирај го овој фајл како .env.local и пополни ги вредностите.
# .env.local не се комитира (е во .gitignore).

# Resend API Key - добиј го од https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Е-пошта на која ќе пристигнуваат пораките
CONTACT_EMAIL=zmaga.dooel@yahoo.com

# Sender адреса од домен верификуван во Resend.
# Додека доменот не е верификуван, остави ја линијата коментирана и
# локално ќе се користи onboarding@resend.dev.
